import java.util.Scanner;

public class EstadisticasSecuencia {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        final int OPCION_PARES = 1;
        final int OPCION_IMPARES = 2;
        final int OPCION_MULTIPLOS_5 = 3;

        char continuar;

        do {
            System.out.println("Analisis de secuencia numerica");
            System.out.print("Ingrese un número entero positivo");
            int n = scanner.nextInt();

            while (n <= 0) {
                System.out.print("El numero tiene que ser mayor a 0 ");
                n = scanner.nextInt();
            }

            int sumaDivisibles4 = 0;
            int contadorMultiplos3 = 0;
            int contadorAmbos = 0;

            for (int i = 1; i <= n; i++) {
                if (i % 4 == 0 && i % 3 == 0) {
                    sumaDivisibles4 += i;
                    contadorMultiplos3++;
                    contadorAmbos++;
                } else if (i % 4 == 0) {
                    sumaDivisibles4 += i;
                } else if (i % 3 == 0) {
                    contadorMultiplos3++;
                }
            }

            System.out.println("Resultados");
            System.out.println("Suma de números divisibles entre 4: " + sumaDivisibles4);
            System.out.println("Cantidad de números múltiplos de 3: " + contadorMultiplos3);
            System.out.println("Cantidad de números divisibles entre 3 y 4 a la vez: " + contadorAmbos);

            System.out.println("\n--- Estadísticas Adicionales ---");
            System.out.println("1. Contar números pares");
            System.out.println("2. Contar números impares");
            System.out.println("3. Contar números múltiplos de 5");
            System.out.print("Seleccione una opción (1-3): ");
            int opcion = scanner.nextInt();

            int contadorEspecial = 0;

            switch (opcion) {
                case OPCION_PARES:
                    for (int i = 1; i <= n; i++) {
                        if (i % 2 == 0) contadorEspecial++;
                    }
                    System.out.println("Total de números pares entre 1 y " + n + ": " + contadorEspecial);
                    break;

                case OPCION_IMPARES:
                    for (int i = 1; i <= n; i++) {
                        if (i % 2 != 0) contadorEspecial++;
                    }
                    System.out.println("Total de números impares entre 1 y " + n + ": " + contadorEspecial);
                    break;

                case OPCION_MULTIPLOS_5:
                    for (int i = 1; i <= n; i++) {
                        if (i % 5 == 0) contadorEspecial++;
                    }
                    System.out.println("Total de números múltiplos de 5 entre 1 y " + n + ": " + contadorEspecial);
                    break;

                default:
                    System.out.println("Opción no válida. No se mostrarán estadísticas adicionales.");
                    break;
            }

            System.out.print("\n¿Desea realizar otro análisis? (s/n): ");
            continuar = scanner.next().toLowerCase().charAt(0);

        } while (continuar == 's');

    }
}
